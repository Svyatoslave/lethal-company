# Copy to .env next to package.json and fill in. Real environment variables override this file.

# Game server
# PORT=8443
# HTTP_PORT=8080
# HTTP_ONLY=1            # behind nginx/Caddy/cloudflared that terminate TLS
# ADMIN_PIN=
# OPERATOR_PIN=

# BODY CAM relay (TURN) — needed for cameras over the internet / mobile data.
# coturn with "use-auth-secret": the same secret as static-auth-secret in turnserver.conf
# TURN_URLS=turn:raid.example.ru:3478?transport=udp,turn:raid.example.ru:3478?transport=tcp,turns:raid.example.ru:5349?transport=tcp
# TURN_SECRET=
# Hosted TURN service with fixed credentials instead of a secret:
# TURN_USERNAME=
# TURN_PASSWORD=
# STUN_URLS=stun:stun.l.google.com:19302
